      "title": "自定义数据使用说明（旧版未更新，可能有问题）",
      "sections": {
        "overview": {
          "title": "先理解这个区块",
          "items": {
            "privateSpace": {
              "label": "私人资料库：",
              "text": "这里的数据只属于你的账号，登录后才能查看与编辑。"
            },
            "mapRendering": {
              "label": "地图呈现：",
              "text": "系统会依据你填写的「特征」分组，并把「值」直接显示在地图点位上。"
            }
          }
        },
        "fieldGuide": {
          "title": "字段怎样理解",
          "items": {
            "feature": {
              "label": "特征：",
              "text": "用来分类与搜索，例如「流摄」、「豪韵」或「昨天」。"
            },
            "value": {
              "label": "值：",
              "text": "地图上真正显示的内容，例如「iu」、「好吃」或「53」。"
            },
            "featureType": {
              "label": "声韵调 / 类别：",
              "text": "给数据一个大类，例如声母、韵母、调值或词汇。"
            },
            "location": {
              "label": "地点简称：",
              "text": "地图上显示的地点名称，建议填你最常用的称呼。"
            },
            "region": {
              "label": "分区：",
              "text": "地点所属的分区，可以填你的自定义分区"
            }
          },
          "examples": {
            "middleChinese": "建议用法：补充公共地图或字表里尚未收录的地点数据。",
            "personalCorpus": "如果你知道某地的读音或词形，但网站暂未收录，可以在这里自行补入。"
          }
        },
        "customCollection": {
          "title": "建立自己的数据集",
          "intro": "当你想整理个人田调、词汇、地名或任何可上图的信息时，可以这样理解各字段：",
          "items": {
            "region": {
              "label": "分区：",
              "text": "地点所属的分区，可以填你自定义的分区"
            },
            "featureType": {
              "label": "声韵调 / 类别：",
              "text": "用于分类，可填「词汇」、「2026田调」等分类。"
            },
            "feature": {
              "label": "特征：",
              "text": "把它当成搜索键，例如「昨天」、「玩耍」或「止・精组・开口」。"
            },
            "value": {
              "label": "值：",
              "text": "把它当成地图标签，例如「从日」、「嬲」或「ei」。"
            },
            "manage": {
              "label": "管理我的所有自定义数据",
              "text": "管理、编辑、删除和搜索你已提交的所有个人自定义数据。"
            }
          },
          "notes": {
            "scope": "先在分区输入框填入你的数据集名称，之后搜索就能只针对这个数据集。",
            "search": "搜索框查的是「特征」，不是「值」。",
            "display": "「值」会直接显示在地图点上，适合放音值、词形、评分或简短注记。"
          }
        },
        "dailyUsage": {
          "title": "不做方言研究也能用",
          "intro": "这套机制也可以当成私人生活地图，例如美食地图、景点收藏或采访记录。",
          "connectors": {
            "regionToLocation": "可包含多个地点",
            "locationToData": "再给这个地点加标签"
          },
          "cards": {
            "region": {
              "label": "声韵调/类别",
              "text": "相当于文件夹名称",
              "example": "例：我的美食地图"
            },
            "location": {
              "label": "地点 (Location)",
              "text": "相当于店名或地点名",
              "example": "例：老王烧烤"
            },
            "feature": {
              "label": "特征",
              "text": "相当于分类标签（搜索用）",
              "example": "例：评价 / 类型"
            },
            "value": {
              "label": "值",
              "text": "相当于地图上显示的内容",
              "example": "例：好吃 / 烧烤"
            }
          },
          "result": "例如把类别填成「我的美食地图」，再搜索特征「评价」，地图上就会在各店名位置显示你填入的评语。"
        },
        "steps": {
          "title": "新增数据步骤",
          "items": {
            "mode": {
              "label": "1. 选择模式：",
              "text": "「逐条新增」适合精确点选坐标；「批量新增」适合从 Excel 或表格粘贴多条数据。"
            },
            "coordinates": {
              "label": "2. 获取坐标：",
              "text": "在单笔模式下，打开面板后直接点击地图位置即可自动填入经纬度。"
            },
            "save": {
              "label": "3. 提交保存：",
              "text": "确认字段无误后送出，数据就会保存到你的个人资料库。"
            }
          }
        },
        "searchMapping": {
          "title": "各搜索场景的字段要求",
          "intro": "自定义数据要能在各搜索接口中被查到，「分类」和「对比特征」两个字段的组合决定了它出现在哪个搜索场景。如果填错了，数据能存但搜索永远查不到。",
          "note": "另外「简称」必须与搜索时指定的方言点一致，否则也查不到。",
          "columns": {
            "scene": "搜索场景",
            "phonology": "分类 必须填",
            "feature": "对比特征 必须填",
            "value": "值 填",
            "desc": "说明"
          },
          "rows": {
            "chars": {
              "scene": "查字",
              "phonology": "漢字",
              "feature": "某个汉字，如 好",
              "value": "该字在该方言点的读音",
              "desc": "搜「好」时命中"
            },
            "tones": {
              "scene": "查调",
              "phonology": "調值",
              "feature": "调类名，如 陰平",
              "value": "调值，如 55",
