            "regionToLocation": "可包含多个地点",
            "locationToData": "再给这个地点加标签"
          },
          "cards": {
            "region": {
              "label": "声韵调/类别",
              "text": "相当于文件夹名称",
              "example": "例：我的美食地图"
            },
            "location": {
              "label": "地点 (Location)",
              "text": "相当于店名或地点名",
              "example": "例：老王烧烤"
            },
            "feature": {
              "label": "特征",
              "text": "相当于分类标签（搜索用）",
              "example": "例：评价 / 类型"
            },
            "value": {
              "label": "值",
              "text": "相当于地图上显示的内容",
              "example": "例：好吃 / 烧烤"
            }
          },
          "result": "例如把类别填成「我的美食地图」，再搜索特征「评价」，地图上就会在各店名位置显示你填入的评语。"
        },
        "steps": {
          "title": "新增数据步骤",
          "items": {
            "mode": {
              "label": "1. 选择模式：",
              "text": "「逐条新增」适合精确点选坐标；「批量新增」适合从 Excel 或表格粘贴多条数据。"
