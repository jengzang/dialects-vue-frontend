              "phonology": "聲母 / 韻母 / 聲調",
              "feature": "中古音查询条件字符串",
              "value": "对应的音值",
              "desc": "如搜「幫」组声母时命中"
            },
            "yinWei": {
              "scene": "查音位",
              "phonology": "聲母 / 韻母 / 聲調",
              "feature": "音值，如 p",
