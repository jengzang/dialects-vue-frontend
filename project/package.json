{
  "name": "vite-project",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "npm run seo:sitemap && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "vue-i18n-extract report --vueFiles \"./src/**/*.{js,vue}\" --languageFiles \"./src/i18n/locales/**/*.json\"",
    "deploy": "npm run build && bash deploy.sh",
    "deploy:ps": "npm run build && powershell -ExecutionPolicy Bypass -File deploy.ps1",
    "seo:sitemap": "node ./scripts/generate-sitemap.mjs",
    "num": "node ./scripts/analyze-vue-loc.mjs --root src",
    "num:out": "node ./scripts/analyze-vue-loc.mjs --root src --out frontend-loc-report.md",
    "num:vue": "node ./scripts/analyze-vue-loc.mjs --root src --ext vue",
    "num:script": "node ./scripts/analyze-vue-loc.mjs --root src --kind script --sort script --order desc",
    "num:style": "node ./scripts/analyze-vue-loc.mjs --root src --kind style --sort style --order desc",
    "num:css": "node ./scripts/analyze-vue-loc.mjs --root src --style css --sort css --order desc",
    "num:scss": "node ./scripts/analyze-vue-loc.mjs --root src --style scss --sort scss --order desc"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.98.0",
    "terser": "^5.46.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.20",
    "vue-i18n-extract": "^2.0.7"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.3.5",
    "@vueuse/core": "^14.1.0",
    "@xmldom/xmldom": "^0.9.10",
    "d3-delaunay": "^6.0.4",
    "echarts": "^5.6.0",
    "fflate": "^0.8.3",
    "maplibre-gl": "^5.16.0",
    "marked": "^18.0.0",
    "opencc-js": "^1.0.5",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.5.1",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "wavesurfer.js": "^7.12.1",
    "xlsx": "^0.18.5"
  }
}
