<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launch_background"
    android:importantForAccessibility="noHideDescendants">

    <FrameLayout
        android:id="@+id/launch_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:id="@+id/launch_title_group"
            android:layout_width="228dp"
            android:layout_height="83dp"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/launch_title_brush"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/launch_title_brush" />

            <ImageView
                android:id="@+id/launch_title_seal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/launch_title_seal" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/launch_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/launch_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@null"
            android:src="@drawable/launch_logo" />

        <TextView
            android:id="@+id/launch_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/launch_description"
            android:textColor="@color/launch_description"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/launch_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/launch_phonetics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.58"
            android:fontFamily="serif"
            android:letterSpacing="0.12"
            android:text="攝 · 韻 · æ · ɔ · tʂʰ"
            android:textColor="@color/launch_description"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/launch_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.55"
            android:textColor="@color/launch_description"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
